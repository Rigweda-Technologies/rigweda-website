VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Search Console "HTML tag" verification code (only the content value)
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification code (only the content value)
VITE_BING_SITE_VERIFICATION=

# Google Analytics 4. GA4 itself is loaded by Google Tag Manager (GTM-T5VTVFKN); this ID is used to
# send the site's custom events (whatsapp_click, phone_click, email_click, generate_lead) to it.
VITE_GA_MEASUREMENT_ID=G-QQSSQQFD9R
# true = mark events for GA4 DebugView. Local testing only; leave false in production.
VITE_GA_DEBUG=false
